# Everforest dark medium. Palette: sainnhe/everforest palette.md (MIT).
# Defined locally because Ghostty's bundled "Everforest Dark Med" uses bg_dim
# as the background and light-palette colours for 9-15.
# ANSI mapping mirrors colors/everforest.vim: black = bg3, white = fg, and the
# bright colours (9-15) deliberately repeat the normal ones (1-7). Bright black
# (8) is grey1 instead of bg3: dim text such as prompts, suggestions and eza's
# dashes is drawn in it, and bg3 on bg0 is nearly invisible (1.55:1).
background = #2D353B
foreground = #D3C6AA
# fg-on-bg0 block cursor, like Vim's reverse-video Cursor group.
cursor-color = #D3C6AA
cursor-text = #2D353B
# bg_visual, Everforest's selection colour (Vim's Visual group).
selection-background = #543A48
selection-foreground = #D3C6AA
palette = 0=#475258
palette = 1=#E67E80
palette = 2=#A7C080
palette = 3=#DBBC7F
palette = 4=#7FBBB3
