.claude/
nul

# Documents\PowerShell is a junction to powershell/, so CurrentUser-scope
# module and script installs (Install-PSResource, Install-Module) land here.
powershell/Modules/
powershell/Scripts/

# Test results and coverage written by windows/tests/Invoke-Checks.ps1 -CI.
windows/tests/out/

# Holds the OpenCode service password, generated per machine.
opencode/service.json

# Third-party yazi packages are restored from yazi/package.toml via
# `ya pkg install`. First-party plugins in this repo are tracked; the glob
# (rather than a bare directory) is what lets the negation below apply.
yazi/plugins/*
!yazi/plugins/nvim-diag.yazi/

# Zellij plugin build output; built by zellij/plugins/Build-Pilot.ps1.
zellij/plugins/pilot/target/
zellij/plugins/pilot.wasm
