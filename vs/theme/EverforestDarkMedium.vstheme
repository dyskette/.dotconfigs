<?xml version="1.0" encoding="utf-8"?>
<!--
  Everforest Dark Medium for Visual Studio 2026.

  Colors are roles from the sainnhe/everforest palette (MIT), mapped to match
  the Neovim, bat and VS Code Everforest themes in this repository: keywords
  red, functions green, types yellow, members blue, strings aqua, numbers and
  constants purple, operators orange, comments grey1, selection bg_visual.

  Shell/ShellInternal carry the Fluent chrome tokens; the Text Editor and
  Roslyn categories carry syntax colors. FallbackId resolves every token not
  set here from the matching built-in theme.
-->
<Themes>
  <Theme Name="Everforest Dark Medium" GUID="{59f03172-33d5-4d39-81c3-32e82b29690f}" FallbackId="{1ded0138-47ce-435e-84ef-9ec1f439b749}">

