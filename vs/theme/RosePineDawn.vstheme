<?xml version="1.0" encoding="utf-8"?>
<!--
  Rose Pine Dawn for Visual Studio 2026.

  Generated from mvllow.rose-pine, themes/rose-pine-dawn-color-theme.json

  Shell/ShellInternal carry the Fluent chrome tokens; the Text Editor and
  Roslyn categories carry syntax colors, mapped through the token table from
  microsoft/theme-converter-for-vs. FallbackId resolves every token not set
  here from the matching built-in theme.

  Editor colors are flattened against the editor background: Visual Studio
  paints marker and selection fills opaquely, so a translucent VS Code value
  such as #6e6a8614 would land as a solid dark block instead of a faint tint.
-->
<Themes>
