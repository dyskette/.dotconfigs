set number
set relativenumber	" Sets relative line numbers
set cursorline		" Highlight the current line
set incsearch

" Sets the map leader
let mapleader="\<Space>"

" Unbinds the Space key (as it is used as a leader key)
nnoremap <Space> <NOP>

" Clipboard
nnoremap <leader>y "+y
vnoremap <leader>y "+y
nnoremap <leader>p "+p
vnoremap <leader>p "+p

" Select
nnoremap <leader>a ggVG

" Indent while remaining in visual mode
vnoremap < <gv
vnoremap > >gv

" Move lines
vnoremap J :vsc Edit.MoveSelectedLinesDown<CR>
vnoremap K :vsc Edit.MoveSelectedLinesUp<CR>

" Toggle comments
nnoremap gcc :vsc Edit.ToggleLineComment<CR>
vnoremap gc :vsc Edit.ToggleLineComment<CR>

" Built-in navigation to navigated items
nnoremap <C-o> :vsc View.NavigateBackward<CR>
nnoremap <C-i> :vsc View.NavigateForward<CR>

" Go to code
nnoremap gd :vsc Edit.GoToDefinition<CR>
nnoremap gi :vsc Edit.GoToImplementation<CR>
nnoremap go :vsc Edit.GoToTypeDefinition<CR>
nnoremap gr :vsc Edit.FindAllReferences<CR>

" Peek in place: inline, no tool window, no tab churn (Esc closes it)
nnoremap gp :vsc Edit.PeekDefinition<CR>

" Search code
nnoremap <leader>ss :vsc Edit.GoToAll<CR>
nnoremap <leader>sf :vsc Edit.GoToFile<CR>
nnoremap <leader>sr :vsc Edit.GoToRecentFile<CR>
nnoremap <leader>sg :vsc Edit.FindInFiles<CR>
nnoremap <leader>so :vsc Edit.GoToSymbol<CR>
nnoremap <leader>sd :vsc View.ErrorList<CR>

" Quickfix-style navigation over the active results list (Error List, Find
" Results, Output). Driven from the editor, so the tool window never needs
" focus -- works around VsVim #2818, where focus after :vsc is unreliable.
nnoremap ]q :vsc Edit.GoToNextLocation<CR>
nnoremap [q :vsc Edit.GoToPrevLocation<CR>

" Diagnostics in the current file, without opening the Error List at all
nnoremap ]d :vsc Edit.GotoNextIssueinFile<CR>
nnoremap [d :vsc Edit.GotoPreviousIssueinFile<CR>

" Dismiss the tool window a previous command left open.
" Native equivalents while focus is inside the pane (VsVim does not handle
" keys there): Shift+Esc closes it, Esc returns focus to the editor.
nnoremap <leader>q :vsc Window.CloseToolWindow<CR>

" Promote the preview tab to a real one, so navigation stops reusing it
nnoremap <leader>k :vsc Window.KeepTabOpen<CR>

" Refactoring
nnoremap <leader>va :vsc View.QuickActions<CR>
vnoremap <leader>va :vsc View.QuickActions<CR>
nnoremap <leader>rn :vsc Refactor.Rename<CR>
nnoremap <leader>rm :vsc Refactor.ExtractMethod<CR>
vnoremap <leader>rm :vsc Refactor.ExtractMethod<CR>

" Git
nnoremap <leader>gb :vsc Team.Git.Annotate<CR>

" Show information
nnoremap K :vsc Edit.QuickInfo<CR>
nnoremap <leader>vd :vsc View.ErrorDescription<CR>

" Unit tests
nnoremap <leader>tt :vsc TestExplorer.RunAllTests<CR>
nnoremap <leader>tr :vsc TestExplorer.RunAllTestsInContext<CR>
nnoremap <leader>td :vsc TestExplorer.DebugAllTestsInContext<CR>
