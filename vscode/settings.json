{
  // ── Window & appearance ───────────────────────────────────────────────────────
  "window.titleBarStyle": "custom",
  "window.menuBarVisibility": "toggle",
  "window.commandCenter": true,
  "workbench.editor.showTabs": "single",

  // ── Theme (auto light/dark) ───────────────────────────────────────────────────
  "window.autoDetectColorScheme": true,
  "workbench.preferredDarkColorTheme": "Gruvbox Dark Medium",
  "workbench.preferredLightColorTheme": "Rosé Pine Dawn",

  // ── Editor ────────────────────────────────────────────────────────────────────
  "editor.fontSize": 14,
  "editor.fontWeight": "400",
  "editor.fontFamily": "'JetBrainsMonoNL Nerd Font', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": false,
  "editor.lineNumbers": "relative",
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": true,
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorSurroundingLines": 5,
  "editor.semanticHighlighting.enabled": true,
  "diffEditor.ignoreTrimWhitespace": false,

  // ── Explorer ──────────────────────────────────────────────────────────────────
  "explorer.confirmDelete": false,

  // ── Terminal ──────────────────────────────────────────────────────────────────
  "terminal.integrated.minimumContrastRatio": 1,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.profiles.linux": {
    "sh (flatpak)": {
      "path": "/usr/bin/sh"
    },
    "bash (host)": {
      "path": "host-spawn",
      "args": ["bash"]
    }
  },
  "terminal.integrated.commandsToSkipShell": ["-workbench.action.quickOpen"],

  // ── Vim ───────────────────────────────────────────────────────────────────────
  "vim.leader": "<space>",
  "vim.hlsearch": true,
  "vim.highlightedyank.enable": true,
  "vim.smartRelativeLine": true,
  "vim.surround": true,
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false
  },
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  "vim.insertModeKeyBindings": [],
  "vim.insertModeKeyBindingsNonRecursive": [],
  "vim.normalModeKeyBindings": [
    {
      "before": [
        "-"
      ],
      "commands": [
        {
          "command": "oil-code.open"
        }
      ]
    },
    {
      "before": [
        "<leader>",
        "e"
      ],
      "commands": [
        "workbench.files.action.focusFilesExplorer"
      ]
    },
    {
      "before": [
        "<leader>",
        "<leader>"
      ],
      "commands": [
        "workbench.action.closeSidebar",
        "workbench.action.closePanel"
      ]
    },
    {
      "before": [
        "leader",
        "g",
        "g"
      ],
      "commands": [
        "magit.status"
      ]
    },
    {
      "before": [
        "<Leader>",
        "g",
        "d"
      ],
      "commands": [
        "git.openChange"
      ]
    },
    {
      "before": [
        "<C-w>",
        "h"
      ],
      "commands": [
        "workbench.action.focusLeftGroup"
      ]
    },
    {
      "before": [
        "<C-w>",
        "j"
      ],
      "commands": [
        "workbench.action.focusBelowGroup"
      ]
    },
    {
      "before": [
        "<C-w>",
        "k"
      ],
      "commands": [
        "workbench.action.focusAboveGroup"
      ]
    },
    {
      "before": [
        "<C-w>",
        "l"
      ],
      "commands": [
        "workbench.action.focusRightGroup"
      ]
    },
    {
      "before": [
        "<C-w>",
        "p"
      ],
      "commands": [
        "workbench.action.focusNextGroup"
      ]
    },
    {
      "before": [
        "u"
      ],
      "after": [],
      "commands": [
        {
          "command": "undo",
          "args": []
        }
      ]
    },
    {
      "before": [
        "<C-r>"
      ],
      "after": [],
      "commands": [
        {
          "command": "redo",
          "args": []
        }
      ]
    },
    {
      "before": [
        "<leader>",
        "y"
      ],
      "after": [
        "\"",
        "+",
        "y"
      ]
    },
    {
      "before": [
        "<leader>",
        "p"
      ],
      "after": [
        "\"",
        "+",
        "p"
      ]
    },
    {
      "before": [
        "<leader>",
        "a"
      ],
      "after": [
        "g",
        "g",
        "V",
        "G"
      ]
    },
    {
      "before": [
        "<C-o>"
      ],
      "commands": [
        "workbench.action.navigateBack"
      ]
    },
    {
      "before": [
        "<C-i>"
      ],
      "commands": [
        "workbench.action.navigateForward"
      ]
    },
    {
      "before": [
        "g",
        "d"
      ],
      "commands": [
        "editor.action.revealDefinition"
      ],
      "silent": true
    },
    {
      "before": [
        "g",
        "D"
      ],
      "commands": [
        "editor.action.revealDeclaration"
      ],
      "silent": true
    },
    {
      "before": [
        "g",
        "i"
      ],
      "commands": [
        "editor.action.goToImplementation"
      ],
      "silent": true
    },
    {
      "before": [
        "g",
        "o"
      ],
      "commands": [
        "editor.action.goToTypeDefinition"
      ],
      "silent": true
    },
    {
      "before": [
        "g",
        "r"
      ],
      "commands": [
        "editor.action.goToReferences"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "s",
        "f"
      ],
      "commands": [
        "workbench.action.quickOpen"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "s",
        "r"
      ],
      "commands": [
        "workbench.action.quickOpenPreviousEditor"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "s",
        "w"
      ],
      "commands": [
        "editor.action.addSelectionToNextFindMatch",
        "workbench.action.findInFiles"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "s",
        "g"
      ],
      "commands": [
        "workbench.action.findInFiles"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "s",
        "o"
      ],
      "commands": [
        "workbench.action.gotoSymbol"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "s",
        "b"
      ],
      "commands": [
        "workbench.action.showAllEditorsByMostRecentlyUsed"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "v",
        "a"
      ],
      "commands": [
        "editor.action.quickFix"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "r",
        "n"
      ],
      "commands": [
        "editor.action.rename"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "r",
        "m"
      ],
      "commands": [
        {
          "command": "editor.action.codeAction",
          "args": {
            "kind": "refactor.extract.function"
          }
        }
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "g",
        "b"
      ],
      "commands": [
        "git.blame.toggleEditorDecoration"
      ],
      "silent": true
    },
    {
      "before": [
        "K"
      ],
      "commands": [
        "editor.action.showHover"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "d",
        "k"
      ],
      "commands": [
        "editor.action.marker.prevInFiles"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "d",
        "j"
      ],
      "commands": [
        "editor.action.marker.nextInFiles"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "<leader>"
      ],
      "commands": [
        "workbench.action.closeSidebar",
        "workbench.action.closePanel",
        "workbench.action.closeAuxiliaryBar"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "f",
        "f"
      ],
      "commands": [
        "editor.action.formatDocument"
      ],
      "silent": false
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [],
  "vim.visualModeKeyBindings": [
    {
      "before": ["<leader>", "y"],
      "after": ["\"", "+", "y"]
    },
    {
      "before": ["<leader>", "p"],
      "after": ["\"", "+", "p"]
    },
    {
      "before": ["<"],
      "after": ["<", "g", "v"]
    },
    {
      "before": [">"],
      "after": [">", "g", "v"]
    },
    {
      "before": ["J"],
      "commands": ["editor.action.moveLinesDownAction"],
      "silent": true
    },
    {
      "before": ["<leader>", "v", "a"],
      "commands": ["editor.action.quickFix"],
      "silent": true
    },
    {
      "before": ["<leader>", "r", "m"],
      "commands": [
        {
          "command": "editor.action.codeAction",
          "args": {
            "kind": "refactor.extract.function"
          }
        }
      ],
      "silent": true
    },
    {
      "before": ["K"],
      "commands": ["editor.action.moveLinesUpAction"],
      "silent": true
    },
    {
      "before": ["<leader>", "s", "w"],
      "commands": [
        "editor.action.addSelectionToNextFindMatch",
        "workbench.action.findInFiles"
      ],
      "silent": true
    },
    {
      "commands": ["editor.action.commentLine"],
      "before": ["<leader>", "c"],
      "when": "editorTextFocus && !editorReadonly"
    }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [],

  // ── File explorer & git UI ────────────────────────────────────────────────────
  "oil-code.hasNerdFont": true,
  "oil-code.disableVimKeymaps": true,
  "magit.display-buffer-function": "same-column",
  "git.blame.editorDecoration.enabled": false,

  // ── Languages ─────────────────────────────────────────────────────────────────
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },

  // ── Remote & containers ───────────────────────────────────────────────────────
  "remote.defaultExtensionsIfInstalledLocally": [
    "kahole.magit",
    "haphazarddev.oil-code"
  ],
  "remote.autoForwardPortsSource": "hybrid",
  "dev.containers.dockerPath": "podman",
  "containers.containerClient": "com.microsoft.visualstudio.containers.podman",
  "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.podmancompose",

  // ── Tooling ───────────────────────────────────────────────────────────────────
  "extensions.ignoreRecommendations": true,
  "redhat.telemetry.enabled": false
}
