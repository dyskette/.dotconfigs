# yazi's `ya pkg` always writes LF; keep it LF on every OS so core.autocrlf
# doesn't report it as modified on Windows.
yazi/package.toml text eol=lf
# Read line by line by bash (project-picker.sh), Git Bash included.
tmux/projects.conf text eol=lf
# cmd.exe scripts (tmux/scripts/edit.cmd) keep cmd's own line endings.
*.cmd text eol=crlf
# Shell scripts are run by bash, Git Bash included, which cannot parse CRLF.
*.sh text eol=lf
