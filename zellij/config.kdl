// Zellij 0.46, starting from nothing: the stock modes, reached with Alt a,
// and the Everforest theme. Everything else is Zellij's own default, on
// purpose — things get added back one at a time, once they are missed.
//
// One file for both machines. Nothing here names a shell or a command, so
// there is nothing left to split: Linux links this file into
// ~/.config/zellij (linux/tasks/dotfiles.yml) and Windows junctions the
// folder into %APPDATA%\zellij\config (windows/links.jsonc).
//
// Commented defaults:  zellij setup --dump-config
// The preset in full:  zellij setup --dump-keybinds unlock-first

// --- Keys -------------------------------------------------------------------
//
// The "unlock-first" preset: the session sits in locked mode, where every key
// reaches the shell, Neovim and the agent untouched, and Alt a is the one key
// Zellij takes. From there a single letter picks a mode — p pane, t tab, r
// resize, s scroll, o session, m move — and Esc comes back.
//
// Alt a rather than the preset's Ctrl g: Ctrl keys belong to readline and to
// the editor. Alt a is free in both.
keybinds preset="unlock-first" unlock="Alt a"

// --- Look -------------------------------------------------------------------
//
// Themes live in themes/ (theme_dir defaults to it). Zellij follows the host
// terminal's light/dark report (DEC mode 2031); a terminal that never reports
// stays dark.
theme_dark "everforest-dark-medium"
theme_light "everforest-light-medium"
