// Zellij 0.46 workspace: one session per repo, one tab per activity (editor,
// agent, lazygit) shown full screen, and floats for the ephemeral shells.
// Moving between repos is the hub's job, which is the busiest key here. The
// reasoning is in zellij/decisions/0001-workspace-model.md; the workflow, the
// keys and the runbook are in zellij/README.md.
//
// Commented defaults: zellij setup --dump-config
// Built-in key preset:  zellij setup --dump-keybinds unlock-first

// --- Keys ---------------------------------------------------------------------
//
// No prefix and no modes, bar one: Zellij stays locked and every binding is
// an Alt key in the shared block below, so there is never a mode to be in or
// to leave (zellij/decisions/0001-workspace-model.md).
//
// The rule is: Alt moves, Alt+Shift nudges a divider, and a letter goes to
// the thing it names. The old Alt g unlock is gone, and with it the split
// where some letters acted and others changed mode, which never became
// muscle memory. Ctrl a is left to readline, where three quarters of the day
// is spent.
//
// The one mode is Alt r, sticky resize: hjkl repeat, Esc leaves. Repeated
// resizing during a presentation is worth it.
keybinds clear-defaults=true {
    // Locked is the only mode you are ever in, so every binding lives here
    // and every other key reaches Neovim, the shell and the agent untouched.
    locked {
        // Alt h/j/k/l: one set of keys across Neovim windows and Zellij
        // panes. pilot hands them to Neovim when it has focus
        // (nvim/lua/config/zellij.lua) and moves Zellij's focus otherwise;
        // left and right cross into the neighbouring tab at the edge, which
        // is how you get from the editor to the agent and back.
        bind "Alt h" "Alt Left" { MessagePlugin "pilot" { name "nav"; payload "left"; }; }
        bind "Alt j" "Alt Down" { MessagePlugin "pilot" { name "nav"; payload "down"; }; }
        bind "Alt k" "Alt Up" { MessagePlugin "pilot" { name "nav"; payload "up"; }; }
        bind "Alt l" "Alt Right" { MessagePlugin "pilot" { name "nav"; payload "right"; }; }

        // Alt H/J/K/L: nudge a divider that way. In Neovim its window
        // divider, else (or with none that way) the Zellij pane divider.
        // Terminals send Alt+Shift+h as Alt + "H".
        bind "Alt H" { MessagePlugin "pilot" { name "resize"; payload "left"; }; }
        bind "Alt J" { MessagePlugin "pilot" { name "resize"; payload "down"; }; }
        bind "Alt K" { MessagePlugin "pilot" { name "resize"; payload "up"; }; }
        bind "Alt L" { MessagePlugin "pilot" { name "resize"; payload "right"; }; }

        // Alt r: the one mode, for resizing repeatedly without holding a
        // modifier (presentations). Esc leaves.
        bind "Alt r" { SwitchToMode "Resize"; }

        // Alt e/a/g: the editor, the agent, lazygit. Each is a tab of its
        // own, full screen; pressing the key while already there goes back
        // where you came from, and a session without that tab yet gets one,
        // started in the focused pane's folder (plugins/pilot, `activity`).
        // Nothing starts by itself: often a question is a grep away.
        bind "Alt e" { MessagePlugin "pilot" { name "activity"; payload "editor"; }; }
        bind "Alt a" { MessagePlugin "pilot" { name "activity"; payload "agent"; }; }
        bind "Alt g" { MessagePlugin "pilot" { name "activity"; payload "lazygit"; }; }

        // Alt t raises the tab's floating layer and puts it away again; Alt n
        // adds a scratch shell to it. Floats hold everything ephemeral:
        // spawn a shell, do a thing, quit.
        //
        // Alt t and not the preset's Alt f: fzf pages its preview with
        // alt-f/alt-b (fzf/fzfrc), which that binding was eating in every
        // pane. Alt t costs readline's transpose-words instead.
        bind "Alt t" { ToggleFloatingPanes; }
        bind "Alt n" { NewFloatingPane; }

        // Alt s: the hub (running sessions, saved sessions and projects in
        // one list, vim keys; README: "The hub"). The way between repos, and
        // so the most used key here.
        bind "Alt s" {
            LaunchOrFocusPlugin "hub" {
                floating true
                move_to_focused_tab true
            }
        }

        // Alt c: the inbox, what every agent and long command in every
        // session is doing (Alt Enter types into a preview without
        // switching). Alt u goes to the next pane anywhere that needs you,
        // switching session if it has to.
        bind "Alt c" { ToggleSessionCard; }
        bind "Alt u" { GoToNextAttention; }

        // Alt m zooms a pane and back; Alt \ returns to the last one.
        bind "Alt m" { ToggleFocusFullscreen; }
        bind "Alt \\" { FocusLastPane; }

        // Alt v: this pane's scrollback in Neovim, with motions, text
        // objects and yank. There is no scroll mode and no search mode:
        // handing the buffer to the editor beats a pager for someone who
        // lives in one, and it keeps the promise that there are no modes.
        bind "Alt v" { EditScrollback; }

        bind "Alt T" { ToggleTheme; }
        bind "Alt d" { Detach; }
        // Asks first, with detach preselected (on_quit below), so closing
        // never kills an agent by accident.
        bind "Alt q" { Quit; }
    }

    // The one mode. Entered with Alt r, left with Esc, Enter or Alt r again.
    resize {
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "Esc" "Enter" "Alt r" { SwitchToMode "Locked"; }
    }
}

// --- Plugins --------------------------------------------------------------------

plugins {
    // Built from plugins/pilot (plugins/Build-Pilot.ps1). agent_command
    // starts an agent pane when a tab has none; zja is in powershell/Zellij.psm1.
    pilot location="file:~/.dotconfigs/zellij/plugins/pilot.wasm" {
        agent_command "pwsh -NoLogo -Command zja; exit $LASTEXITCODE"
    }

    // The session hub: the same plugin drawing one list of running sessions,
    // saved sessions and projects (plugins/pilot/src/hub). projects_command
    // prints the projects root and the projects, most used first; the hub
    // runs it in the background and shows the last result meanwhile.
    hub location="file:~/.dotconfigs/zellij/plugins/pilot.wasm" {
        view "hub"
        projects_command "pwsh -NoLogo -NoProfile -Command [Console]::OutputEncoding=[Text.Encoding]::UTF8;Import-Module ~/.dotconfigs/powershell/Zellij.psm1 -DisableNameChecking;Get-ZjHubProject"
    }
    // The hub as a lobby: the only pane of a throwaway session, shown when
    // no session is open yet (layouts/lobby.kdl; `zj` without arguments).
    // q leaves Zellij there instead of closing a popup.
    lobby location="file:~/.dotconfigs/zellij/plugins/pilot.wasm" {
        view "hub"
        lobby "true"
        projects_command "pwsh -NoLogo -NoProfile -Command [Console]::OutputEncoding=[Text.Encoding]::UTF8;Import-Module ~/.dotconfigs/powershell/Zellij.psm1 -DisableNameChecking;Get-ZjHubProject"
    }
}

load_plugins {
    // Loaded at session start, headless, so the first Alt h is instant.
    pilot
}

// --- Behaviour -------------------------------------------------------------------

// pwsh with the profile: zj, zja and the fzf tools exist in every pane.
default_shell "pwsh"
// One-line bar: the tabs are the activities (editor, agent, lazygit), plus
// the sessions with something for you.
default_layout "compact"
// Locked, always. The keybindings are all Alt keys bound in the locked
// block, and Alt r is the only way into another mode, so this is where every
// session starts and where it returns. With clear-defaults there is no
// preset to imply it.
default_mode "locked"
// Alt q asks first, with detach preselected: closing never kills agents by
// accident.
on_quit "ask_detach"

pane_frames true
pane_frame_style "titles"
ui {
    pane_frames {
        rounded_corners true
        // The session name is in the bar already.
        hide_session_name true
    }
}

// A stack lists the panes it is not showing as titles, in a row rather than
// the default column, so Alt h/l steps along it. Tabs hold one activity each
// now, so stacks are rare: this is for the occasional long-running process
// split off beside an activity.
stacked_pane_list_orientation "horizontal"

// Agents and builds print a lot.
scroll_buffer_size 50000
copy_on_select true
show_startup_tips false

// Resurrection after a reboot: layout, cwds and commands (each waits for
// Enter), plus the last screen of every pane so you see where it was.
session_serialization true
serialization_interval 30
serialize_pane_viewport true
scrollback_lines_to_serialize 2000

// Open the nested session prompt only when asked (ssh into a box running
// Zellij).
nested_session_handling "ask"

// The web server stays off; start it on demand with `zellij web` (README:
// "Watching from elsewhere"). Sessions opt in to sharing one by one.
web_server false
web_sharing "off"

// --- Attention: the inbox, tab markers and notifications --------------------------
//
// OpenCode reports working / waiting / idle and Claude Code working / needs you / done themselves
// (OSC 7501), and the shell prompt marks each command's start and exit code
// (OSC 133, powershell/Microsoft.PowerShell_profile.ps1). Long commands in a
// float are tracked the same way, so a build started in a scratch shell still
// reports.
attention {
    enabled true
    frame_markers true
    tab_markers true
    host_status true
    // List commands running longer than this as working, and report them
    // when they end.
    track_commands true
    done_threshold_secs 15
    idle_rule "watched"
    startup_card "attention"
    desktop_notifications {
        needs_you true
        failed true
        done false
    }
    tray_badge {
        needs_you true
        failed true
        done true
        working true
        quiet false
        new_output false
    }
    // Everforest orange, red, green and blue.
    tray_badge_colors {
        needs_you "#e69875"
        failed "#e67e80"
        done "#a7c080"
        working "#7fbbb3"
        quiet "#859289"
        new_output "#83c092"
    }
}

// --- Look --------------------------------------------------------------------------

// Themes live in themes/ (theme_dir defaults to it). Zellij follows the
// host terminal's light/dark reports (DEC mode 2031) and passes the switch on
// to Neovim. A terminal that never reports leaves it dark; Alt g T, or
// `zellij action toggle-theme`, switches by hand.
theme_dark "everforest-dark-medium"
theme_light "everforest-light-medium"

// --- The Zellij terminal (`zellij terminal`) -----------------------------------------
//
// Only read by Zellij's own window, the alternative to Windows Terminal with
// a tray icon, the inbox badge and desktop notifications (README: "Zellij as
// the terminal").
terminal {
    font "JetBrainsMonoNL Nerd Font"
    font_size 10
    ligatures false
    padding 4
    padding_balance true
    cursor_style "block"
    hide_pointer_while_typing true
    startup_mode "remember"
    paste_keys "Ctrl Shift v" "Shift Insert"
    copy_keys "Ctrl Shift c"
    // Windows Terminal's Everforest Dark Medium (windows_terminal/settings.json).
    theme {
        foreground "#d3c6aa"
        background "#2d353b"
        cursor "#d3c6aa"
        black "#475258"
        red "#e67e80"
        green "#a7c080"
        yellow "#dbbc7f"
        blue "#7fbbb3"
        magenta "#d699b6"
        cyan "#83c092"
        white "#d3c6aa"
        bright_black "#859289"
        bright_red "#e67e80"
        bright_green "#a7c080"
        bright_yellow "#dbbc7f"
        bright_blue "#7fbbb3"
        bright_magenta "#d699b6"
        bright_cyan "#83c092"
        bright_white "#d3c6aa"
    }
}
