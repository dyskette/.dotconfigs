themes {
    // Everforest medium, matching tmux/everforest-*-medium.conf. Palette:
    // sainnhe/everforest palette.md (MIT). Zellij's built-in everforest-dark
    // and everforest-light use the old palette (#4b565c) and a Tokyo Night
    // orange (#ff9e64), and the light one draws unselected list rows with
    // text and background both #5c6a72. Roles follow those built-ins; rows
    // select to bg3. Light greens are too pale for text on them (2.7:1), so
    // the light selected ribbon is inverted fg instead (5.2:1).
    //
    //          dark     light               dark     light
    // bg0      #2d353b  #fdf6e3     red     #e67e80  #f85552
    // bg3      #475258  #e6e2cc     orange  #e69875  #f57d26
    // fg       #d3c6aa  #5c6a72     yellow  #dbbc7f  #dfa000
    // grey1    #859289  #939f91     green   #a7c080  #8da101
    // grey2    #9da9a0  #829181     aqua    #83c092  #35a77c
    //                               blue    #7fbbb3  #3a94c5
    //                               purple  #d699b6  #df69ba
    everforest-dark-medium {
        text_unselected {
            base 211 198 170
            background 45 53 59
            emphasis_0 230 152 117
            emphasis_1 131 192 146
            emphasis_2 167 192 128
            emphasis_3 214 153 182
        }
        text_selected {
            base 211 198 170
            background 71 82 88
            emphasis_0 230 152 117
            emphasis_1 131 192 146
            emphasis_2 167 192 128
            emphasis_3 214 153 182
        }
        ribbon_selected {
            base 45 53 59
            background 167 192 128
            emphasis_0 230 126 128
            emphasis_1 230 152 117
            emphasis_2 214 153 182
            emphasis_3 127 187 179
        }
        ribbon_unselected {
            base 211 198 170
            background 71 82 88
            emphasis_0 230 126 128
            emphasis_1 79 88 94
            emphasis_2 127 187 179
            emphasis_3 214 153 182
        }
        table_title {
            base 167 192 128
            background 0
            emphasis_0 230 152 117
            emphasis_1 131 192 146
            emphasis_2 167 192 128
            emphasis_3 214 153 182
        }
        table_cell_selected {
            base 211 198 170
            background 71 82 88
            emphasis_0 230 152 117
            emphasis_1 131 192 146
            emphasis_2 167 192 128
            emphasis_3 214 153 182
        }
        table_cell_unselected {
            base 211 198 170
            background 45 53 59
            emphasis_0 230 152 117
            emphasis_1 131 192 146
            emphasis_2 167 192 128
            emphasis_3 214 153 182
        }
        list_selected {
            base 211 198 170
            background 71 82 88
            emphasis_0 230 152 117
            emphasis_1 131 192 146
            emphasis_2 167 192 128
            emphasis_3 214 153 182
        }
        list_unselected {
            base 211 198 170
            background 45 53 59
            emphasis_0 230 152 117
            emphasis_1 131 192 146
            emphasis_2 167 192 128
            emphasis_3 214 153 182
        }
        frame_selected {
            base 167 192 128
            background 0
            emphasis_0 230 152 117
            emphasis_1 131 192 146
            emphasis_2 214 153 182
            emphasis_3 0
        }
        frame_highlight {
            base 230 152 117
            background 0
            emphasis_0 214 153 182
            emphasis_1 230 152 117
            emphasis_2 230 152 117
            emphasis_3 230 152 117
        }
        exit_code_success {
            base 167 192 128
            background 0
            emphasis_0 131 192 146
            emphasis_1 133 146 137
            emphasis_2 214 153 182
            emphasis_3 127 187 179
        }
        exit_code_error {
            base 230 126 128
            background 0
            emphasis_0 219 188 127
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 214 153 182
            player_2 127 187 179
            player_3 167 192 128
            player_4 219 188 127
            player_5 131 192 146
            player_6 230 152 117
            player_7 230 126 128
            player_8 157 169 160
            player_9 214 153 182
            player_10 127 187 179
        }
    }
    everforest-light-medium {
